{
  "name": "watsthesplit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bun server/index.ts",
    "smoke": "bun test/smoke.ts",
    "prepare": "husky",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "lint:staged": "lint-staged",
    "lint:staged:check": "lint-staged --check"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "jose": "^6.0.10",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bun-types": "^1.4.3",
    "husky": "9",
    "lint-staged": "15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.ts?(x)": [
      "bunx biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md,css,html}": [
      "bunx biome check --write --no-errors-on-unmatched"
    ]
  }
}
